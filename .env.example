# Copy this file to .env (which is never committed) and fill it in.
# Each member uses their own key: it is personal and has a spending limit.
# Your key is one of two kinds: uncomment the lines for yours (remove the "# "), and only those.

# An Anthropic key (it starts with sk-ant-): one line.
# ANTHROPIC_API_KEY=

# An OpenRouter key (it starts with sk-or-): these two lines, and NO ANTHROPIC_API_KEY line,
# or the SDK would send that one instead. The code is the same for both kinds of key.
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
